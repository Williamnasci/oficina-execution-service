{
  "openapi": "3.0.3",
  "info": {
    "title": "Oficina Execution Service",
    "version": "0.2.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/executions/{id}": {
      "get": {
        "summary": "Consultar execução",
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "400": {
            "description": "Payload inválido"
          },
          "401": {
            "description": "Autenticação inválida"
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de idempotência"
          },
          "422": {
            "description": "Regra de negócio inválida"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/executions/{id}/diagnosis": {
      "post": {
        "summary": "Registrar diagnóstico",
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "400": {
            "description": "Payload inválido"
          },
          "401": {
            "description": "Autenticação inválida"
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de idempotência"
          },
          "422": {
            "description": "Regra de negócio inválida"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Diagnosis"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/executions/{id}/start": {
      "post": {
        "summary": "Iniciar reparo",
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "400": {
            "description": "Payload inválido"
          },
          "401": {
            "description": "Autenticação inválida"
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de idempotência"
          },
          "422": {
            "description": "Regra de negócio inválida"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/executions/{id}/finish": {
      "post": {
        "summary": "Finalizar reparo",
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "400": {
            "description": "Payload inválido"
          },
          "401": {
            "description": "Autenticação inválida"
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de idempotência"
          },
          "422": {
            "description": "Regra de negócio inválida"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/health": {
      "get": {
        "security": [],
        "summary": "/health",
        "responses": {
          "200": {
            "description": "Operacional"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "security": [],
        "summary": "/ready",
        "responses": {
          "200": {
            "description": "Operacional"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "security": [],
        "summary": "/metrics",
        "responses": {
          "200": {
            "description": "Operacional"
          }
        }
      }
    },
    "/stock-items": {
      "post": {
        "summary": "Criar peça",
        "responses": {
          "201": {
            "description": "Sucesso"
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de estoque"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockItemCreate"
              }
            }
          }
        }
      },
      "get": {
        "summary": "Listar estoque",
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de estoque"
          }
        }
      }
    },
    "/stock-items/{id}": {
      "get": {
        "summary": "Consultar peça",
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de estoque"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "patch": {
        "summary": "Atualizar peça",
        "responses": {
          "204": {
            "description": "Sucesso"
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de estoque"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockItemUpdate"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Desativar peça",
        "responses": {
          "204": {
            "description": "Sucesso"
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de estoque"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/stock-items/{id}/availability": {
      "get": {
        "summary": "Consultar saldo disponível (administrador ou operador)",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockAvailability"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão"
          },
          "409": {
            "description": "Conflito de estoque"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Diagnosis": {
        "type": "object",
        "required": [
          "diagnosis",
          "lines"
        ],
        "properties": {
          "diagnosis": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "quantity",
                "description"
              ],
              "properties": {
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                },
                "unitPriceCents": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": {
                  "type": "string"
                },
                "sku": {
                  "type": "string"
                },
                "serviceId": {
                  "type": "string"
                }
              },
              "anyOf": [
                {
                  "required": [
                    "unitPriceCents"
                  ]
                },
                {
                  "required": [
                    "serviceId"
                  ]
                }
              ]
            },
            "description": "Serviços e mão de obra; peças são escolhidas em stockItems. Se vazio, os serviços da abertura são usados."
          },
          "stockItems": {
            "type": "array",
            "maxItems": 100,
            "description": "Se omitido, usa as peças selecionadas na abertura. Lista vazia remove a seleção inicial.",
            "items": {
              "type": "object",
              "required": [
                "stockItemId",
                "quantity"
              ],
              "properties": {
                "stockItemId": {
                  "type": "string",
                  "format": "uuid"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                }
              }
            }
          }
        }
      },
      "StockItemCreate": {
        "type": "object",
        "required": [
          "name",
          "unitPrice"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "sku": {
            "type": "string",
            "nullable": true
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "unitPrice": {
            "type": "number",
            "minimum": 0,
            "maximum": 99999999.99
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "StockItemUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "sku": {
            "type": "string",
            "nullable": true
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "unitPrice": {
            "type": "number",
            "minimum": 0,
            "maximum": 99999999.99
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "StockAvailability": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer"
          },
          "reserved": {
            "type": "integer"
          },
          "available": {
            "type": "integer"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
