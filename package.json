{
  "name": "oficina-execution-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:cov": "c8 --all --include=src/**/* --exclude=src/main.mjs --extension=.ts --extension=.mjs --reporter=text --reporter=lcov --check-coverage --lines=80 --branches=80 --functions=80 --statements=80 node --test test/*.test.mjs",
    "start": "node --import dd-trace/initialize.mjs dist/main.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "quality": "eslint src --max-warnings=0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "c8": "^10.1.3",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "eslint-plugin-sonarjs": "^3.0.0",
    "typescript-eslint": "^8.0.0",
    "globals": "^16.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "amqplib": "^0.10.9",
    "express": "^5.1.0",
    "zod": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.3",
    "dd-trace": "^6.11.0",
    "helmet": "^8.1.0",
    "swagger-ui-express": "^5.0.1",
    "mongodb": "^6.20.0"
  }
}
